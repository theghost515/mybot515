<%- include('partials/header') %>

<header class="page-head">
  <h1>بلاغات الدعم الفني</h1>
  <p class="muted">جميع المشاكل التي أرسلها الأعضاء عبر زر "الإبلاغ عن مشكلة"</p>
</header>

<table class="data-table">
  <thead>
    <tr><th>المستخدم</th><th>المشكلة</th><th>الحالة</th><th>التاريخ</th><th></th></tr>
  </thead>
  <tbody>
    <% tickets.forEach(t => { %>
      <tr>
        <td><%= t.username %><br /><span class="muted small"><%= t.discord_user_id %></span></td>
        <td class="cell-arabic"><%= t.issue_text %></td>
        <td><span class="badge <%= t.status === 'مفتوحة' ? 'badge-open' : 'badge-closed' %>"><%= t.status %></span></td>
        <td class="small"><%= t.created_at %></td>
        <td>
          <% if (t.status === 'مفتوحة') { %>
            <form method="POST" action="/tickets/<%= t.id %>/close">
              <button type="submit" class="btn-secondary">إغلاق</button>
            </form>
          <% } %>
        </td>
      </tr>
    <% }) %>
    <% if (!tickets.length) { %>
      <tr><td colspan="5" class="empty">لا توجد بلاغات حتى الآن.</td></tr>
    <% } %>
  </tbody>
</table>

<%- include('partials/footer') %>
